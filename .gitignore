# installer (Wails): its build/ holds the icons and platform files, kept; the output and generated code are not
!installer/build/
installer/build/bin/
installer/frontend/wailsjs/
# installer/assets/release/ is tracked: the firmware release the installer embeds (our code only; the vendor
# loader region is zeroed and rebuilt on the user's machine from the downloaded V20)
